  "components": [
    {
      "name": "主操作",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "暖杏色小圆角按钮；白昼使用对应松绿变体。",
      "html": "<button class=\"ds-primary\">探索这颗星球<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:28px;min-height:52px;padding:15px 23px;border:0;border-radius:6px;background:var(--accent,#eab58f);color:#17332b;font:550 14px ShugeSans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif;cursor:pointer;transition:background .2s ease,transform .25s cubic-bezier(.16,1,.3,1),color .2s ease}.ds-primary svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round;}.ds-primary:hover{background:#f2c7a2;transform:translateY(-2px)}.ds-primary:active{transform:translateY(0)}.ds-primary:focus-visible{outline:2px solid var(--accent,#eab58f);outline-offset:5px;}.ds-primary:disabled{cursor:default;opacity:.4}.ds-primary[data-time=day]{background:#365e46;color:#f6efe0}.ds-primary[data-time=day]:hover{background:#426e52}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "次操作",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "透明底和细底线提供轻量的次级入口。",
      "html": "<a class=\"ds-secondary\" href=\"#about\">认识鼠哥</a>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:28px;min-height:52px;padding:12px 0;border-bottom:1px solid #8da99780;background:transparent;color:var(--text,#f2f0e2);font:400 14px ShugeSans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif;text-decoration:none;transition:color .2s ease}.ds-secondary:hover{color:var(--accent,#eab58f)}.ds-secondary:focus-visible{outline:2px solid var(--accent,#eab58f);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "相机按钮",
      "kind": "button",
      "refersTo": "camera-button",
      "description": "圆形描边按钮，只在可用三维舞台提供相机操作。",
      "html": "<button class=\"ds-camera\" aria-label=\"靠近星球\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></button>",
      "css": ".ds-camera{width:44px;height:44px;display:grid;place-items:center;border:1px solid #9eb5a138;border-radius:50%;background:#112d2d80;color:var(--text,#f2f0e2);cursor:pointer;transition:background .2s ease,border-color .2s ease}.ds-camera svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round;width:17px;height:17px}.ds-camera:hover{background:#354e3d;border-color:#9eb5a180}.ds-camera:focus-visible{outline:2px solid var(--accent,#eab58f);outline-offset:5px;}.ds-camera:disabled{cursor:default;opacity:.4}@media(prefers-reduced-motion:reduce){.ds-camera{transition:none}}"
    },
    {
      "name": "筛选与实验标签",
      "kind": "chip",
      "refersTo": "filter-tab",
      "description": "细底线表示选择，aria-pressed 同步选中状态。",
      "html": "<div class=\"ds-tabs\" role=\"group\" aria-label=\"筛选作品\"><button aria-pressed=\"true\">全部</button><button aria-pressed=\"false\">互动学习</button></div>",
      "css": ".ds-tabs{display:flex;gap:20px;flex-wrap:wrap;background:var(--paper,#f0f0e7);border-bottom:1px solid var(--rule,#cdd6c9)}.ds-tabs button{font:400 13px ShugeSans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif;padding:10px 0;min-height:44px;border:0;border-bottom:2px solid transparent;background:none;color:#5a715d;white-space:nowrap;cursor:pointer}.ds-tabs button[aria-pressed=true]{color:#305a3b;border-bottom-color:#59815b}.ds-tabs button:hover{color:#a75f37}.ds-tabs button:focus-visible{outline:2px solid var(--ink,#243b32);outline-offset:5px;}"
    },
    {
      "name": "横向作品条目",
      "kind": "card",
      "refersTo": "work-preview",
      "description": "缩略图与标题摘要并排，靠分隔线组织，不增加包围阴影。",
      "html": "<article class=\"ds-work\"><a class=\"ds-work-preview\" href=\"#work\" aria-label=\"打开作品预览\"></a><div><h3>一个可以探索的世界</h3><p>打开作品，亲手体验这个想法。</p><a class=\"ds-work-link\" href=\"#work\">体验作品</a></div></article>",
      "css": ".ds-work{display:grid;grid-template-columns:138px minmax(0,1fr);column-gap:23px;padding:0 0 27px;border-bottom:1px solid var(--rule,#cdd6c9);background:var(--paper,#f0f0e7);color:var(--ink,#243b32);font-family:ShugeSans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif}.ds-work-preview{display:block;aspect-ratio:1.3;border-radius:3px;overflow:hidden;min-width:0;background:#dae0d1}.ds-work h3{font-size:18px;font-weight:550;line-height:1.5;margin:0 0 8px}.ds-work p{font-size:13px;line-height:1.85;color:var(--muted,#53675a);margin:0 0 8px}.ds-work-link{display:inline-flex;align-items:center;min-height:36px;font-size:12px;color:#4e7153;text-decoration:underline;text-decoration-color:#a6baa0;text-underline-offset:5px}.ds-work-link:hover{color:#a75f37}.ds-work a:focus-visible{outline:2px solid var(--ink,#243b32);outline-offset:5px;}"
    },
    {
      "name": "原生实验参数",
      "kind": "input",
      "description": "可见标签和数值配合原生 range；高度保留手动操作空间。",
      "html": "<div class=\"ds-parameter\"><label for=\"ds-frequency\">频率比<output>3 : 2</output></label><input id=\"ds-frequency\" type=\"range\" min=\"1\" max=\"9\" step=\"1\" value=\"3\"></div>",
      "css": ".ds-parameter{font-family:ShugeSans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif;background:var(--paper,#f0f0e7)}.ds-parameter label{font-size:13px;display:flex;justify-content:space-between;margin-bottom:7px;color:#4e6e51}.ds-parameter output{color:#995a35;font-variant-numeric:tabular-nums}.ds-parameter input{width:100%;height:40px;accent-color:#ae7951;cursor:pointer}.ds-parameter input:focus-visible{outline:2px solid var(--ink,#243b32);outline-offset:5px;}"
    },
    {
      "name": "地区导航",
      "kind": "nav",
      "description": "图标与文字并列，当前页和悬停用杏色与轻微上移表示。",
      "html": "<nav class=\"ds-nav\" aria-label=\"探索小镇\"><a href=\"#work\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 5h18v13H3Zm5 17h8m-4-4v4M7 9l3 3-3 3m6 0h4\"/></svg>创作馆</a><a href=\"#lab\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 3h6m-5 0v7L4 20c-.3.5 0 1 1 1h14c1 0 1.3-.5 1-1l-6-10V3M7 15h10\"/></svg>实验馆</a></nav>",
      "css": ".ds-nav{display:flex;gap:30px;align-items:center;border-top:1px solid #8da99738;padding-top:16px}.ds-nav a{display:flex;align-items:center;gap:10px;min-height:44px;font:400 13px ShugeSans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif;color:var(--soft,#b9c9bf);text-decoration:none;white-space:nowrap;transition:color .2s ease,transform .25s cubic-bezier(.16,1,.3,1)}.ds-nav svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round;width:20px;height:20px}.ds-nav a:hover,.ds-nav a[aria-current=page]{color:var(--accent,#eab58f);transform:translateY(-2px)}.ds-nav a:focus-visible{outline:2px solid var(--accent,#eab58f);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none}}"
    },
    {
      "name": "地标标签",
      "kind": "custom",
      "refersTo": "landmark",
      "description": "世界上的投影标签；预览展示可见态，真实隐藏态由场景计算。",
      "html": "<a class=\"ds-landmark\" href=\"#work\"><span></span>创作馆<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-landmark{display:inline-flex;align-items:center;gap:9px;min-height:44px;padding:8px 15px;border-radius:4px;background:#102c2be8;box-shadow:0 8px 22px #04161245;color:var(--text,#f2f0e2);font:400 12px ShugeSans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif;text-decoration:none;white-space:nowrap;transition:background .2s ease,color .2s ease}.ds-landmark>span{height:4px;width:4px;background:var(--accent,#eab58f);border-radius:50%}.ds-landmark svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round;width:13px;height:13px}.ds-landmark:hover{background:#2d4b40;color:#f8e3c8}.ds-landmark:focus-visible{outline:2px solid var(--accent,#eab58f);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-landmark{transition:none}}"
    },
    {
      "name": "瓷白阅读面板",
      "kind": "custom",
      "refersTo": "content-panel",
      "description": "纸面、舒展的正文与独立操作区；此片段仅演示视觉，不实现路由或焦点行为。",
      "html": "<aside class=\"ds-panel\"><div class=\"ds-panel-top\"><a href=\"#\">回到小镇</a><button aria-label=\"关闭内容面板\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></button></div><div class=\"ds-panel-body\"><h2>好奇心<br>实验馆<span>。</span></h2><p>让曲线随参数变化，让想法拥有可以操作的形状。</p></div></aside>",
      "css": ".ds-panel{max-width:640px;background:var(--paper,#f0f0e7);color:var(--ink,#243b32);box-shadow:-24px 0 80px #03171355;font-family:ShugeSans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif}.ds-panel-top{display:flex;justify-content:space-between;align-items:center;padding:25px 38px 18px;font-size:13px;height:90px}.ds-panel-top a{display:inline-flex;align-items:center;min-height:44px;color:#526b56;text-decoration:none}.ds-panel-top button{width:44px;height:44px;display:grid;place-items:center;border:1px solid #b7c7b5;border-radius:50%;color:#4b6c57;background:none;cursor:pointer;transition:background .2s ease}.ds-panel-top svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round;width:22px;height:22px}.ds-panel-top button:hover{background:#e1e6d9}.ds-panel-top a:focus-visible,.ds-panel-top button:focus-visible{outline:2px solid var(--ink,#243b32);outline-offset:5px;}.ds-panel-body{padding:26px 46px 60px}.ds-panel h2{font-size:clamp(34px,3.25vw,48px);font-weight:550;line-height:1.4;letter-spacing:-.035em;margin:0 0 28px}.ds-panel h2 span{color:#ad653e}.ds-panel p{font-size:14px;line-height:2.05;color:var(--muted,#53675a);margin:0 0 23px;max-width:68ch}@media(prefers-reduced-motion:reduce){.ds-panel-top button{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "好奇心引力场",
    "overview": "这是一颗值得靠近的植物小星球。松林夜色托起苔绿地表、瓷白建筑、陶土屋顶与杏色微光；细草、树冠、湖水、环轨和漂浮小岛把好奇心变成可探索的空间。世界有丰富细节，界面保持有秩序的留白。\n\n阅读发生在瓷白纸面上。作品以有分隔线的横向条目展开，标题、摘要和链接形成清楚的阅读节奏。主操作保留温暖杏色与轻微圆角；轨道标识、圆形相机按钮和细线导航延续球体的形态。",
    "keyCharacteristics": [
      "松林夜色、瓷白、鼠尾草绿与杏色组成连续的材质世界。",
      "球面建筑、程序化植被、水面与传送门承担探索主体。",
      "有分隔线的作品条目和浅色阅读面板提供稳定的信息层级。",
      "普通链接、键盘入口、动态暂停与画质切换伴随三维探索。"
    ],
    "rules": [
      {
        "name": "The Material Continuity Rule",
        "body": "新增界面和场景先复用对应材质角色；区分杏色主操作、陶土屋顶、阅读纸面与建筑墙体。",
        "section": "colors"
      },
      {
        "name": "The Reading Floor Rule",
        "body": "功能文字保持源码现有的（12px）下限；窄屏身份行中（11px）的装饰性拉丁签名不作为新功能标签的模板。",
        "section": "typography"
      },
      {
        "name": "The Direct Passage Rule",
        "body": "每个内容地区都有普通 hash 链接。阅读不能以旋转、射线命中、巡游或声音为前提。",
        "section": "layout"
      },
      {
        "name": "The World Carries Depth Rule",
        "body": "让几何、光照和覆盖关系承担主深度，作品条目使用纸面分隔线保持平稳。",
        "section": "elevation"
      },
      {
        "name": "The Evidence Boundary Rule",
        "body": "源码定义、CPU 场景检查、HTTP 可用、GPU 视觉、浏览器交互和实体手机体验分别记录；前一层不替后一层作验收结论。",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** 复用松林夜色、瓷白、鼠尾草与杏色的材料角色，并区分界面色和场景材质。",
      "**Do** 保留单列横向作品条目、清楚的分隔线和舒展的阅读行高。",
      "**Do** 为内容提供普通链接、键盘入口和可见操作状态。",
      "**Do** 让功能文字保持 12px 下限，并分别检查手机触摸目标与阅读布局。",
      "**Do** 保留暂停、画质选择、减少动态与阅读降级路径。",
      "**Do** 把源码能力、运行时观察和视觉验收分别记录。"
    ],
    "donts": [
      "**Don't** 用无意义粒子替代具有地标和植被细节的可探索世界。",
      "**Don't** 把作品条目恢复成一排有阴影的通用卡片或旧版胶囊筛选。",
      "**Don't** 让巡游、动画、射线命中或声音成为获取内容的前提。",
      "**Don't** 把概念场景描述为实景复刻，或把程序化动画描述为物理仿真。",
      "**Don't** 把继承的 V2 截图、静态检查或本文档描述为 V3 GPU 与手机体验已通过。"
    ]
  }
}
